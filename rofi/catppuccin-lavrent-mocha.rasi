/**
 * Catppuccin Mocha theme
 * Color palette copied from https://catppuccin.com/palette
 * https://github.com/hiimsergey/rofi-catppuccin
 */

* {
    base: #1e1e2e;
    surface0: #313244;
    overlay0: #6c7086;
    text: #cdd6f4;

    mauve: #cba6f7;
    red: #f38ba8;
    peach: #fab387;
    green: #a6e3a1;
    blue: #89b4fa;
    lavender: #b4befe;

    background-color: @base;
}

window {
    width: 1000;
    height: 100%;

    location: north west;
    anchor: north west;

    border: 0;
    border-radius: 0;
}

mainbox {
    spacing: 0;
    children: [inputbar, message, listview];
}

inputbar {
    color: @text;
    padding: 6 10;
    background-color: @base;
}

message {
    padding: 6;
    background-color: @overlay0;
}

listview {
    padding: 2;
    border-radius: 0;
    border: 0;
    background-color: @base;
    dynamic: true;
    scrollbar: false;
}

textbox {
    text-color: @text;
    background-color: inherit;
}

error-message {
    border: 20 20 20 20;
}

entry, prompt, case-indicator {
    text-color: inherit;
}

prompt {
    margin: 0 6 0 0;
}

element {
    padding: 2 8;
    border-radius: 3;
    background-color: @surface0;
    text-color: #ffffff;
}

element.selected.normal {
    background-color: @blue;
    text-color: #ffffff;
}

element.selected.normal element-text,
element.selected.normal element-icon {
    text-color: inherit;
}

element-text, element-icon {
    size: 12;
    margin: 0 4 0 0;
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    size: 32;
}

element.normal.active, element.alternate.active {
    background-color: @peach;
}

element.selected.active {
    background-color: @green;
}

element.normal.urgent, element.alternate.urgent {
    background-color: @red;
}

element.selected.urgent {
    background-color: @mauve;
}
