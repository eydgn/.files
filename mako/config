# Position & Size
anchor=top-right
width=400
height=200
margin=12
padding=12
border-radius=8

# Timeout & Icons
default-timeout=10000
icons=1
max-icon-size=48

# Behavior
max-visible=5
group-by=app-name
sort=-time
layer=overlay

# Font
font=JetBrainsMono Nerd Font 12

# Colors
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#74c7ec
progress-color=over #313244

[urgency=high]
border-color=#fab387
default-timeout=0
