#!/bin/bash
entries=$(ps -eo pid,user,comm --no-headers | awk '$2 != "root" && $2 != "nobody"' | sort -k1,1rn | head -500)
selected=$(echo "$entries" | rofi -dmenu -i -p 'Kill')
[[ -z "$selected" ]] && exit 0
pid=$(echo "$selected" | awk '{print $1}')
name=$(echo "$selected" | awk '{print $NF}')
kill "$pid" 2>/dev/null && notify-send "rofi-kill" "Killed $name" -t 2000 || notify-send "rofi-kill" "Failed to kill $name" -t 2000
